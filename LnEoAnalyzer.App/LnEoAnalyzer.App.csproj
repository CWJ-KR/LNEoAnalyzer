<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <!-- TiePie libtiepie-hw 네이티브 라이브러리가 64비트이므로 솔루션 플랫폼과 관계없이 항상 x64 실행 파일로 빌드합니다 -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LnEoAnalyzer</RootNamespace>
    <AssemblyName>LnEoAnalyzer</AssemblyName>
    <AssemblyTitle>LN EO Analyzer</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.58" />
    <PackageReference Include="TiePie.Hardware" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LnEoAnalyzer.Core\LnEoAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.Win32.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
